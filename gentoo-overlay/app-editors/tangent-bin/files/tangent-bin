#!/bin/sh

APP_ASAR="/usr/share/tangent-bin/app.asar"

if command -v electron >/dev/null 2>&1; then
	exec electron "${APP_ASAR}" "$@"
fi

for candidate in electron-42 electron-41 electron-40 electron-bin; do
	if command -v "${candidate}" >/dev/null 2>&1; then
		exec "${candidate}" "${APP_ASAR}" "$@"
	fi
done

echo "tangent: could not find Electron runtime (virtual/electron)" >&2
exit 1
